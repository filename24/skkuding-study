meta {
  name: 06-주문 커서 페이지네이션
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/order?cursor=1&limit=3
  body: none
  auth: none
}

docs {
  # GET /order?cursor=1&limit=3 — 주문 목록 커서 페이지네이션

  **기대: 200 OK**

  `cursor: { id: 1 }`과 `skip: 1`, `take: 3`을 적용하여
  1번 주문 다음부터 3개의 주문과 연관 주문 상품들을 가져옵니다.
}

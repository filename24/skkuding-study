meta {
  name: 치킨집 대량 등록 (createMany)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chicken/batch
  body: json
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

body:json {
  {
    "chickens": [
      {
        "name": "푸라닭 율전점",
